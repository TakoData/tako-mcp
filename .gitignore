# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Local env / secrets
.env
.env.*
.venv/

# Superpowers specs/plans are internal working docs — this repo is public, so
# keep them local-only (never commit them).
docs/superpowers/

# Workers / Node
# No trailing slash: a `node_modules/` pattern matches directories ONLY, so a
# `node_modules` SYMLINK (git stores it as a mode-120000 blob, not a tree) slips
# past it and gets committed — which is exactly how one landed in this repo from
# a worktree that symlinked back to the main checkout's installed deps.
node_modules
.wrangler/
workers/dist/
# Wrangler local-only env (per-developer DB / Tako web app overrides). Do not
# commit; secrets/local URLs land here when iterating against a local backend.
workers/.dev.vars
workers/.dev.vars.*

# Local git worktrees. Already the working convention in this repo; ignoring
# the directory stops a stray `git add` from committing an entire checkout.
.worktrees/

# Agent/tooling scratch. Throwaway probe scripts and captured API responses
# land here while iterating against staging; they routinely contain live tokens
# and query dumps, so they must never be committable.
scratch_space/
.gstack/
workers/scripts/evals/skills/out/
