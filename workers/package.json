{
  "name": "tako-mcp-workers",
  "version": "0.19.5",
  "private": true,
  "description": "Tako MCP server on Cloudflare Workers (mcp.tako.com).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/widget/tsconfig.json",
    "test": "vitest run && vitest run -c vitest.widget.config.ts && vitest run -c vitest.scripts.config.ts",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "predeploy:staging": "npm run schemas:check && npm run registry:check",
    "deploy:production": "wrangler deploy --env production",
    "predeploy:production": "npm run schemas:check && npm run registry:check",
    "cf-typegen": "wrangler types",
    "registry:gen": "tsx scripts/gen-registry.ts",
    "registry:check": "tsx scripts/gen-registry.ts --check",
    "schemas:gen": "tsx scripts/gen-schemas.ts",
    "schemas:check": "tsx scripts/gen-schemas.ts --check",
    "smoke": "tsx scripts/smoke.ts",
    "golden": "tsx scripts/golden.ts",
    "panel": "tsx scripts/panel.ts",
    "eval:web-snippet": "tsx scripts/evals/web-snippet/run.ts",
    "eval:web-snippet:judge": "tsx scripts/evals/web-snippet/judge.ts",
    "eval:web-snippet:report": "tsx scripts/evals/web-snippet/report.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@apidevtools/swagger-parser": "^10.1.1",
    "@cloudflare/vitest-pool-workers": "^0.9.11",
    "@cloudflare/workers-types": "^4.20250617.0",
    "@iarna/toml": "^2.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.0",
    "json-schema-to-zod": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "3.2.6",
    "wrangler": "^4.40.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": ">=4.59.1"
    },
    "undici": "^7.28.0",
    "hono": "^4.12.30",
    "vite": "^6.4.3",
    "ws": "^8.21.0",
    "fast-uri": "^3.1.3"
  }
}
